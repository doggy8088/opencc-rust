#!/bin/sh
# 本機 pre-commit hook（啟用方式見 repo 文件的「本機與 CI 驗證分工」）。
set -e
echo "[pre-commit] cargo fmt --check"
cargo fmt --all -- --check
# 6 repo 完整並排時才跑產生器一致性檢查（產生器會檢查全家族的產物；
# 缺任何一個 sibling 都會誤報，少於 6 repo 的環境自動略過）
if [ -d ../OpenCC ] && [ -d ../opencc-py ] && [ -d ../opencc-swift ] && [ -d ../opencc-js ] && [ -d ../opencc-cli ]; then
  echo "[pre-commit] generate_taiwan_quality.py --check"
  python3 tools/generate_taiwan_quality.py --check
fi
